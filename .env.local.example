# ============================================================
# CareerGPS 环境变量配置模板
# 使用方法：复制本文件为 .env.local，并填入 Supabase 控制台中的真实值
# 获取路径：Supabase Dashboard -> Project Settings -> API
# ============================================================

# 【必填 · 前端可见】Supabase 项目 URL
# 示例：https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 【必填 · 前端可见】Supabase anon / public key
# 用于浏览器端与服务端（带用户会话）的常规请求，受 RLS 保护
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 【必填 · 仅服务端】Supabase service_role key
# 拥有绕过 RLS 的管理权限，只能在 Server Actions / API Routes 中使用
# ⚠️ 切勿以 NEXT_PUBLIC_ 前缀暴露到浏览器
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------
# 手机号短信登录（Auth）
# ------------------------------------------------------------
# SMS_PROVIDER：console（开发，验证码打服务端日志）| webhook | aliyun | tencent
SMS_PROVIDER=console

# 可选：OTP 签名密钥（生产环境建议单独设置）
# OTP_HASH_SECRET=your-random-secret
# OTP_RESEND_COOLDOWN_SECONDS=60

# webhook 模式：指向自建云函数（可转发到阿里云/腾讯云短信 API）
# SMS_WEBHOOK_URL=https://your-domain.com/api/sms/send
# SMS_WEBHOOK_SECRET=your-webhook-secret

# 阿里云短信（SMS_PROVIDER=aliyun）
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# ALIYUN_SMS_REGION_ID=cn-hangzhou

# 腾讯云短信（SMS_PROVIDER=tencent）
# TENCENT_SMS_SECRET_ID=
# TENCENT_SMS_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN_NAME=
# TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_REGION=ap-guangzhou

# ------------------------------------------------------------
# Supabase Auth 控制台配置（手机号登录无需邮件确认）
# ------------------------------------------------------------
# 【本地开发】
# 1. Authentication -> URL Configuration
#    Site URL:        http://localhost:3000
#
# 【生产环境 · Vercel 部署后必改】
#    Site URL:        https://你的项目.vercel.app
#
# 2. 手机号登录走 /api/auth/send-otp 与 /api/auth/verify-otp
#    不依赖 Email Provider，也不会向用户发送境外确认邮件
#    可在 Authentication -> Providers -> Email 中关闭 Confirm email（若仍保留邮箱登录）

# 旧版 GitHub OAuth 回调（可选，当前登录页未启用）
# Redirect URLs:   https://你的项目.vercel.app/auth/callback

# ------------------------------------------------------------
# 阶段四：AI Agent（4.1 起必填）
# ------------------------------------------------------------

# DeepSeek API Key（在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=your-deepseek-api-key

# 可选：DeepSeek 兼容接口 Base URL（默认 https://api.deepseek.com）
# @ai-sdk/deepseek 会拼接 /chat/completions → https://api.deepseek.com/chat/completions
# 若使用带 /v1 的地址也可： https://api.deepseek.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# 旧版 deepseek-chat 已于 2026-07-24 弃用，请勿再使用
# 图片 OCR 在浏览器本地完成（Tesseract.js），无需 Vision API Key

# 天眼查 / 企查查 API Key（阶段 4.4 企业排雷时使用，可选）
# COMPANY_API_KEY=your-company-api-key

# ------------------------------------------------------------
# Vercel 部署：在 Vercel Dashboard -> Settings -> Environment Variables
# 将以上所有【必填】变量逐一添加（Production / Preview / Development 均勾选）
# 切勿将 .env.local 提交到 GitHub
# ------------------------------------------------------------
